{
  "expo": {
    "name": "GKS Strzegowo",
    "slug": "gks-strzegowo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gksstrzegowo",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {

      "supportsTablet": true,
      "bundleIdentifier": "com.gksstrzegowo.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gksstrzegowo.app",
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },

    "plugins": [

      "expo-router",
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-image-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1d4ed8"
        }
      ]
    ],


    "extra": {
      "router": {},
      "eas": {
        "projectId": "449e5618-f475-4c5d-9c39-dbf8bf385187"
      }
    }
  }
}
